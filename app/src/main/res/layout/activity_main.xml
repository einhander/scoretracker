<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingHorizontal="8dp" android:background="@color/surface">
    <FrameLayout android:id="@+id/topPanelContainer" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:id="@+id/topPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:id="@+id/fileNameText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:ellipsize="middle" android:maxLines="1" android:text="@string/no_midi" android:textSize="16sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/trackSelectorRow" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/trackLabelText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:labelFor="@id/trackSpinner" android:text="@string/track_label" android:textSize="12sp" />
            <Spinner android:id="@+id/trackSpinner" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:contentDescription="@string/track_label" />
        </LinearLayout>
        <Button android:id="@+id/testModeButton" style="@style/Widget.TempoScore.QuietButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/test_mode" android:visibility="gone" />
        <ImageButton android:id="@+id/settingsButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_settings" android:tint="@color/ink" android:contentDescription="@string/settings" />
        <ImageButton android:id="@+id/collapsePanelButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/arrow_up_float" android:tint="@color/ink" android:contentDescription="@string/panel_collapse" android:tooltipText="@string/panel_collapse" />
    </LinearLayout>
    <LinearLayout android:id="@+id/fullTempoRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical">
        <Button android:id="@+id/listenButton" android:layout_width="132dp" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="8dp" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:textAllCaps="false" android:enabled="false" android:text="@string/start_listening" />
        <Button android:id="@+id/loadMidiButton" style="@style/Widget.TempoScore.QuietButton" android:layout_width="120dp" android:layout_height="48dp" android:text="@string/load_midi" />
        <ImageButton android:id="@+id/resetButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_reset" android:tint="@color/control_icon" android:enabled="false" android:contentDescription="@string/reset_position" />
        </LinearLayout>
        <LinearLayout android:id="@+id/fullTempos" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/midiTempoGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center">
            <Button android:id="@+id/tempoDecreaseButton" style="@style/Widget.TempoScore.QuietButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="0dp" android:text="−" android:textSize="20sp" android:contentDescription="@string/tempo_adjustment_decrease" />
            <TextView android:id="@+id/tempoText" style="@style/Widget.TempoScore.Metric" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:text="@string/midi_unavailable" />
            <TextView android:id="@+id/tempoAdjustmentText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/muted" android:text="0" />
            <Button android:id="@+id/tempoIncreaseButton" style="@style/Widget.TempoScore.QuietButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="0dp" android:text="+" android:textSize="20sp" android:contentDescription="@string/tempo_adjustment_increase" />
        </LinearLayout>
        <TextView android:id="@+id/liveTempoText" style="@style/Widget.TempoScore.Metric" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="@color/accent" android:text="@string/live_unavailable" />
        <TextView android:id="@+id/transportTempoText" style="@style/Widget.TempoScore.Metric" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/transport_unavailable" />
    </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical">
        <TextView android:id="@+id/positionText" style="@style/Widget.TempoScore.Status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/position_initial" />
        <TextView android:id="@+id/positionStatusText" style="@style/Widget.TempoScore.Status" android:layout_width="0dp" android:layout_weight="1.5" android:layout_height="wrap_content" android:text="@string/position_idle" />
        <TextView android:id="@+id/confidenceText" style="@style/Widget.TempoScore.Status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:text="@string/beat_unavailable" />
    </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/compactPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
        android:orientation="horizontal" android:background="@color/surface_alt" android:gravity="center_vertical"
         android:paddingHorizontal="4dp" android:visibility="gone">
        <LinearLayout android:id="@+id/compactContent" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/compactControls" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical">
        <Button android:id="@+id/compactListenButton" android:layout_width="132dp" android:layout_height="48dp"
            android:minWidth="0dp" android:paddingHorizontal="8dp" android:textSize="14sp" android:maxLines="1"
            android:ellipsize="end" android:textAllCaps="false" android:enabled="false" android:text="@string/start_listening" />
        <ImageButton android:id="@+id/compactResetButton" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_reset"
            android:tint="@color/control_icon" android:enabled="false" android:contentDescription="@string/reset_position" />
        <TextView android:id="@+id/compactTrackText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:paddingHorizontal="8dp" android:textSize="14sp" android:textColor="@color/muted" android:maxLines="1"
             android:ellipsize="end" android:text="@string/no_midi" android:visibility="gone" />
        </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/compactMetricsContainer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:id="@+id/compactTempos" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/compactMidiTempoGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center">
                <Button android:id="@+id/compactTempoDecreaseButton" style="@style/Widget.TempoScore.QuietButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="0dp" android:text="−" android:textSize="20sp" android:contentDescription="@string/tempo_adjustment_decrease" />
                <TextView android:id="@+id/compactTempoText" style="@style/Widget.TempoScore.Metric" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:text="@string/midi_unavailable" />
                <TextView android:id="@+id/compactTempoAdjustmentText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/muted" android:text="0" />
                <Button android:id="@+id/compactTempoIncreaseButton" style="@style/Widget.TempoScore.QuietButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="0dp" android:text="+" android:textSize="20sp" android:contentDescription="@string/tempo_adjustment_increase" />
            </LinearLayout>
            <TextView android:id="@+id/compactLiveTempoText" style="@style/Widget.TempoScore.Metric" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/accent" android:text="@string/live_unavailable" />
            <TextView android:id="@+id/compactTransportTempoText" style="@style/Widget.TempoScore.Metric" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="14sp" android:text="@string/transport_unavailable" />
        </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/compactTestControls" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:gravity="center_vertical" android:visibility="gone">
            <ImageButton android:id="@+id/compactTestPlayPauseButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_play" android:tint="@color/control_icon" android:enabled="false" android:contentDescription="@string/test_play" />
            <ImageButton android:id="@+id/compactTestRestartButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_restart_audio" android:tint="@color/control_icon" android:enabled="false" android:contentDescription="@string/test_restart_description" />
            <Button android:id="@+id/compactTestModeButton" style="@style/Widget.TempoScore.QuietButton" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="64dp" android:paddingHorizontal="8dp" android:text="@string/test_mode_compact" />
        </LinearLayout>
        </LinearLayout>
        <ImageButton android:id="@+id/expandPanelButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/arrow_down_float"
            android:tint="@color/accent" android:contentDescription="@string/panel_expand" android:tooltipText="@string/panel_expand" />
    </LinearLayout>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/white">
            <com.einhander.temposcore.ui.ScoreStaffView android:id="@+id/scoreView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="@string/score_preview" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="28dp" android:paddingHorizontal="8dp" android:gravity="center_vertical">
                <TextView android:id="@+id/nowText" style="@style/Widget.TempoScore.Status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="15sp" android:text="@string/now_empty" />
                <TextView android:id="@+id/nextText" style="@style/Widget.TempoScore.Status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="15sp" android:text="@string/next_empty" />
            </LinearLayout>
        </LinearLayout>
        <ScrollView android:id="@+id/testControlsContainer" android:layout_width="280dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:background="@color/surface_alt" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="8dp">
                <LinearLayout android:id="@+id/testControlsRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:id="@+id/testStateText" style="@style/Widget.TempoScore.Status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/test_inactive" />
                    <Button android:id="@+id/exitTestModeButton" style="@style/Widget.TempoScore.QuietButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/test_exit" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <Button android:id="@+id/loadTestAudioButton" style="@style/Widget.TempoScore.QuietButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/load_test_audio" />
                    <TextView android:id="@+id/testAudioNameText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="middle" android:text="@string/no_test_audio" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <Button android:id="@+id/testPlayPauseButton" style="@style/Widget.TempoScore.QuietButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:enabled="false" android:text="@string/test_play" />
                    <Button android:id="@+id/testRestartButton" style="@style/Widget.TempoScore.QuietButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:enabled="false" android:text="@string/test_restart" />
                    <Button android:id="@+id/testStopButton" style="@style/Widget.TempoScore.QuietButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:enabled="false" android:text="@string/test_stop" />
                </LinearLayout>
                <SeekBar android:id="@+id/testSeekBar" android:layout_width="match_parent" android:layout_height="48dp" android:enabled="false" android:max="1000" android:contentDescription="@string/test_seek_description" />
                <TextView android:id="@+id/testTimeText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/test_time_initial" android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
