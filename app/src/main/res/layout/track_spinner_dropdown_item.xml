<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="64dp" android:orientation="vertical"
    android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:gravity="center_vertical">
    <TextView android:id="@+id/trackTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="1" android:ellipsize="end" android:textSize="13sp" android:textColor="@color/ink" />
    <TextView android:id="@+id/trackDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:textColor="@color/muted" />
</LinearLayout>
